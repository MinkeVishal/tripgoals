# --- Appwrite (public) ---
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id

# --- Appwrite (SERVER ONLY — never prefix with NEXT_PUBLIC_) ---
# Needs scopes: users.read/write, sessions.write, tables/rows read+write, files read+write,
# and tables.write (only for scripts/migrate-v2.ts and scripts/cutover-v2.ts).
APPWRITE_API_KEY=your_server_api_key

# --- Site ---
